# ==============================================================================
# Portfolio Local Development Environment Variables Template
# Copy this file to .env and adjust values for local development:
#   cp .env.example .env
# ==============================================================================

# Server Port
PORT=3001

# MongoDB Connection String (Local MongoDB or Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# JWT Secrets (Minimum 32 characters for security)
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters

# Master Admin Credentials (For initial seed)
ADMIN_EMAIL=admin@tranhieu.dev
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001
